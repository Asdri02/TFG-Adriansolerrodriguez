# ── Anthropic ─────────────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal Access Token with at least "Contents: Read" on the target repo.
# Generate at https://github.com/settings/tokens
GITHUB_TOKEN=

# Target repo for bridge.py in the form "owner/repo". Optional — bridge.py
# falls back to the project default if this is unset.
GITHUB_REPO=
